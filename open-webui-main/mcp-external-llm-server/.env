# Perplexity Search MCP Server Configuration
PERPLEXITY_API_KEY=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
PERPLEXITY_API_URL=https://api.perplexity.ai/chat/completions
MCP_SERVER_PORT=8200
LOG_LEVEL=INFO

# Perplexity API 기본 설정
PERPLEXITY_MODEL=sonar-pro
PERPLEXITY_MAX_TOKENS=1024
PERPLEXITY_TEMPERATURE=0.2
PERPLEXITY_SEARCH_RECENCY=month

# Redis 캐싱 설정 (USE_REDIS=true로 활성화)
USE_REDIS=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
CACHE_TTL=300

# 워커 설정
WORKERS=4

# =============================================================================
# SSL/HTTPS 설정 (Duck DNS + Let's Encrypt)
# =============================================================================
# SSL 활성화 여부
SSL_ENABLED=false

# SSL 인증서 파일 경로 (Let's Encrypt 인증서)
SSL_CERT_FILE=ssl/certs/fullchain.pem
SSL_KEY_FILE=ssl/certs/privkey.pem

# 개인키 비밀번호 (암호화된 키 사용 시)
# SSL_KEY_PASSWORD=

# Duck DNS 설정
# DUCKDNS_DOMAIN=your-subdomain
# DUCKDNS_TOKEN=your-token
# DUCKDNS_FULL_DOMAIN=your-subdomain.duckdns.org
