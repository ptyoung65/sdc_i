# =============================================================================
# Vector Graph RAG Service 환경 설정
# =============================================================================
# 적용 서버: 192.168.122.178 (개발/테스트)
# Milvus 서버: 192.168.122.85:19530
# LLM 서버: http://192.168.0.14:11434/v1 (Ollama OpenAI 호환)
# 임베딩 모델: BAAI/bge-m3 (1024 dim, 로컬 캐시 사용)
# 서비스 포트: 8015
# =============================================================================

# ---------- 서비스 설정 ----------
GRAPH_RAG_HOST=0.0.0.0
GRAPH_RAG_PORT=8015
GRAPH_RAG_WORKERS=1

# ---------- OpenAI 호환 LLM 설정 ----------
# Ollama (192.168.0.14:11434) - OpenAI 호환 API 사용
VGRAG_OPENAI_API_KEY=ollama
VGRAG_OPENAI_BASE_URL=http://192.168.0.14:11434/v1
VGRAG_LLM_MODEL=gemma4:latest
VGRAG_LLM_TEMPERATURE=0.0
VGRAG_LLM_MAX_RETRIES=3
VGRAG_USE_LLM_CACHE=true

# ---------- 임베딩 모델 설정 ----------
# HuggingFace 로컬 모델 사용 (BAAI/bge-m3, 1024 차원)
VGRAG_EMBEDDING_MODEL=BAAI/bge-m3
VGRAG_EMBEDDING_DIMENSION=1024

# HuggingFace 캐시 경로 (Open WebUI 컨테이너 볼륨에 저장된 모델 재사용)
HF_HUB_CACHE=/home/chatpro/.local/share/containers/storage/volumes/openwebui-data/_data/cache/embedding/models
TRANSFORMERS_OFFLINE=1

# ---------- Milvus 벡터 DB 설정 ----------
VGRAG_MILVUS_URI=http://192.168.122.85:19530
# VGRAG_MILVUS_TOKEN=  # Zilliz Cloud 사용 시만 필요
# VGRAG_MILVUS_DB=default

# ---------- 컬렉션 설정 ----------
# 기존 Open WebUI Milvus 컬렉션과 충돌 방지를 위해 prefix 사용
VGRAG_COLLECTION_PREFIX=vgrag
VGRAG_ENTITY_COLLECTION=vgrag_entities
VGRAG_RELATION_COLLECTION=vgrag_relations
VGRAG_PASSAGE_COLLECTION=vgrag_passages

# ---------- 검색 파라미터 ----------
VGRAG_ENTITY_TOP_K=20
VGRAG_RELATION_TOP_K=20
VGRAG_ENTITY_SIMILARITY_THRESHOLD=0.9
VGRAG_RELATION_SIMILARITY_THRESHOLD=-1.0
VGRAG_EXPANSION_DEGREE=1
VGRAG_RELATION_NUMBER_THRESHOLD=1000
VGRAG_FINAL_TOP_K=3

# ---------- 배치 처리 ----------
VGRAG_BATCH_SIZE=32

# ---------- 캐시 디렉토리 ----------
LLM_CACHE_DIR=/home/chatpro/open-webui-main/services/graph-rag/cache/llm
NER_CACHE_DIR=/home/chatpro/open-webui-main/services/graph-rag/cache/ner
