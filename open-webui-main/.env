# ============================================
# Open WebUI Configuration
# ============================================

# ============================================
# Ollama Configuration
# ============================================
ENABLE_OLLAMA_API=true

# ============================================
# Environment Mode Configuration
# ============================================
# ENVIRONMENT: development, test, production
# - development: 한국어 강화 내부 서비스 사용 (청킹, 임베딩, LLM)
# - test/production: 외부 Samsung Display 서비스 사용
ENVIRONMENT=development
VITE_ENVIRONMENT=development

# ============================================
# n8n Integration Configuration
# ============================================
VITE_N8N_BASE_URL=http://169.254.1.2:5678
N8N_WEBHOOK_URL=http://169.254.1.2:5678/webhook/edm-search

# ============================================
# Host Configuration (Auto-detected)
# ============================================
# This IP is auto-detected from the server's network interface
# Supports multiple environments: development, test, production
# Server has dual IPs:
#   - 11.93.33.10 (Primary/Fixed IP - recommended)
#   - 192.168.122.177 (Secondary/Dynamic DHCP IP)
HOST_IP=11.93.33.10
HOST_IP_SECONDARY=192.168.122.178

# PUBLIC_ prefix is required for client-side access in SvelteKit
PUBLIC_HOST_IP=192.168.122.85

# ============================================
# Database Configuration (PostgreSQL)
# ============================================
DATABASE_URL=postgresql://sdc_dev_user:sdc_dev_pass_2025@localhost:5433/sdc_dev

# ============================================
# LLM Server Configuration (환경별 자동 선택)
# ============================================
# Production/Test: Samsung Display 외부 LLM API
OPENAI_API_BASE_URL_PRODUCTION=https://samsungdisplay.net/api/gateway/rep/serving/337/v1
OPENAI_API_KEY_PRODUCTION=784313265d504febb42d0442d6be26b1
DEFAULT_MODELS_PRODUCTION=Qwen3-235B

# Development: MCP 외부 LLM 서버 경유 (OpenAI & Perplexity 모델)
# localhost/external-llm-mcp-server를 통해 GPT 및 Perplexity 모델 사용
# Note: host.containers.internal:8100 for MCP server routing
OPENAI_API_BASE_URL_DEVELOPMENT=http://192.168.0.14:8000/v1
OPENAI_API_KEY_DEVELOPMENT=sk-hqiKm0Tf01rR_0hHJt14Ye6ao62MsAM4kWX6L8lPrfU
DEFAULT_MODELS_DEVELOPMENT=gemma4:latest

# Active configuration (MCP 외부 LLM 서버 경유)
# localhost/external-llm-mcp-server를 통해 OpenAI & Perplexity 모델 사용
OPENAI_API_BASE_URL=http://192.168.0.14:8000/v1
OPENAI_API_KEY=sk-hqiKm0Tf01rR_0hHJt14Ye6ao62MsAM4kWX6L8lPrfU
DEFAULT_MODELS=gemma4:latest

# ============================================
# Embedding Server Configuration (환경별 자동 선택)
# ============================================
# Production/Test: Samsung Display 외부 임베딩 API (주석 처리 - 내부 모델 사용)
#RAG_EMBEDDING_ENGINE_PRODUCTION=openai
#RAG_EMBEDDING_MODEL_PRODUCTION=bge-m3
#RAG_OPENAI_API_BASE_URL_PRODUCTION=https://genai.samsungdisplay.net/api/gateway/rep/serving/66/v1
#RAG_OPENAI_API_KEY_PRODUCTION=7e71f89144374f95b2c8334191412519

# Development: Dify와 동일한 임베딩 모델 사용 (bge-m3)
# 중요: Dify와 벡터 데이터 공유를 위해 동일한 임베딩 모델 필수
RAG_EMBEDDING_ENGINE_DEVELOPMENT=
RAG_EMBEDDING_MODEL_DEVELOPMENT=BAAI/bge-m3
# For external API in development (if needed)
# RAG_EMBEDDING_ENGINE_DEVELOPMENT=openai
# RAG_OPENAI_API_BASE_URL_DEVELOPMENT=http://192.168.0.14:8000/v1
# RAG_OPENAI_API_KEY_DEVELOPMENT=your-api-key-here

# Active configuration (환경 변수로 직접 설정)
# 중요: Dify와 동일한 bge-m3 임베딩 모델 사용 (벡터 데이터 공유)
# bge-m3: 1024차원, 다국어 지원, Dify 기본 모델
RAG_EMBEDDING_ENGINE=
RAG_EMBEDDING_MODEL=BAAI/bge-m3
SENTENCE_TRANSFORMERS_HOME=/app/embeddings/models
HF_HOME=/app/embeddings/models

# RAG_EMBEDDING_ENGINE 옵션:
# - (비어있음) = Default (SentenceTransformers) - 로컬 임베딩 모델 사용
# - ollama = Ollama API 사용
# - openai = OpenAI API 사용
# - azure_openai = Azure OpenAI Services 사용

# Available embedding models:
# - BAAI/bge-m3 (다국어, 1024차원) ✅ Dify 호환 - Active
# - jhgan/ko-sroberta-multitask (한국어 RoBERTa, 768차원)
# - jhgan/ko-sbert-sts (Korean SBERT)
# - BM-K/KoSimCSE-roberta (Korean SimCSE)

# For production deployment with external API:
# RAG_EMBEDDING_ENGINE=openai
# RAG_OPENAI_API_BASE_URL=https://PRODUCTION_SERVER_IP/api/v1
# RAG_OPENAI_API_KEY=your-api-key (내부 서버는 불필요)

# ============================================
# Chunking Configuration (환경별)
# ============================================
# Production/Test: 기본 청킹
CHUNK_SIZE_PRODUCTION=1000
CHUNK_OVERLAP_PRODUCTION=200

# Development: 한국어 최적화 청킹 (로컬 서비스)
CHUNK_SIZE_DEVELOPMENT=500
CHUNK_OVERLAP_DEVELOPMENT=100
KOREAN_CHUNKING_SERVICE=http://localhost:8002

# Active configuration (자동 설정됨)
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# ============================================
# Server Configuration
# ============================================
# Port configuration (컨테이너 내부 포트: 8080, 외부 포트: 3000)
PORT=8080
HOST=0.0.0.0

# Ollama URL (optional, can be disabled if not using)
OLLAMA_BASE_URL=http://192.168.0.14:11434

# ============================================
# CORS Configuration
# ============================================
# Allow specific origins for CORS (required when using credentials)
# Use semicolons to separate multiple origins
# Includes localhost, localhost IP, and both server IPs for maximum compatibility
CORS_ALLOW_ORIGIN=http://localhost:3000;http://127.0.0.1:3000;http://11.93.33.10:3000;http://192.168.122.178:3000
# ----- [2026-02-02] 보안 취약점 수정: X-Forwarded-For 변조 방지 -----
# FORWARDED_ALLOW_IPS='*' 는 모든 클라이언트의 X-Forwarded-For를 신뢰하여 IP 변조 가능
# 리버스 프록시를 사용하지 않으므로 비활성화
# 리버스 프록시 사용 시: FORWARDED_ALLOW_IPS='프록시서버IP1,프록시서버IP2'
FORWARDED_ALLOW_IPS=''
# ----- [2026-02-02] 보안 취약점 수정 완료 -----

# ============================================
# Privacy Settings
# ============================================
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false

# ============================================
# Vector Database Configuration (Milvus)
# ============================================
# Use Milvus instead of ChromaDB
# 중요: Dify와 동일한 Milvus 서버 사용 (벡터 데이터 공유)
VECTOR_DB=milvus
MILVUS_URI=http://11.93.33.10:19530
VITE_MILVUS_BASE_URL=http://192.168.122.85:19530

# Remote Milvus Server Configuration
# Dify와 동일한 원격 Milvus 서버 사용
ENABLE_REMOTE_MILVUS=true
REMOTE_MILVUS_HOST=192.168.122.85
REMOTE_MILVUS_PORT=19530
REMOTE_MILVUS_USER=
REMOTE_MILVUS_SSH_KEY=~/.ssh/id_rsa
REMOTE_MILVUS_SCRIPT_PATH=/home/chatpro/open-webui-main

# Disable ChromaDB
CHROMA_TELEMETRY=false
CHROMA_CLIENT_DISABLED=true

# ============================================
# Docling Configuration
# ============================================
# Docling server for advanced document parsing
# CONTENT_EXTRACTION_ENGINE=docling
# DOCLING_SERVER_URL=http://localhost:5001
# 기본 파서(unstructured) 사용 - 별도 서버 불필요
CONTENT_EXTRACTION_ENGINE=default
VITE_DOCUANALYZER_URL=http://localhost:5001

# ============================================
# Additional Settings
# ============================================
# Enable RAG
ENABLE_RAG_WEB_SEARCH=true
ENABLE_RAG_LOCAL_WEB_FETCH=true

# ============================================
# RAG Search Configuration
# ============================================
# 벡터 유사도 검색만 사용 (하이브리드 검색 비활성화)
ENABLE_RAG_HYBRID_SEARCH=false

# 리랭킹 비활성화 (단순 점수 정렬만 사용)
RAG_RERANKING_MODEL=
RAG_RERANKING_ENGINE=

# RAG 검색 설정
RAG_TOP_K=5
RAG_RELEVANCE_THRESHOLD=0.0
VITE_RAG_SEARCH_API_URL=http://localhost:8080/api/v1

# Web search configuration (optional)
# ENABLE_RAG_WEB_SEARCH=true
# SEARXNG_QUERY_URL=http://localhost:8080/search?q=<query>

# File upload settings
ENABLE_IMAGE_GENERATION=false
ENABLE_COMMUNITY_SHARING=false

# Security
WEBUI_SECRET_KEY=change-this-to-a-random-secret-key-for-production
PUBLIC_API_BASE_URL=http://localhost:8080

# ============================================
# Frontend Feature Flags & Settings
# ============================================
VITE_ENABLE_MOCK_MODE=false
VITE_DEBUG_LOGGING=true
VITE_ERROR_TRACKING=false
VITE_API_TIMEOUT=30000
VITE_MAX_RETRY=3

# Elasticsearch Configuration
VITE_ELASTICSEARCH_URL=
VITE_ELASTICSEARCH_API_TOKEN=
